# Pre-commit: formatting of staged files, then a full type check.
# Unit tests (npm test) run in CI on every push and pull request.

# --config pins lint-staged to this repo's config. Without it, lint-staged v16
# also discovers per-directory configs shipped inside node_modules packages.
npx lint-staged --config .lintstagedrc.cjs

npm run check:types

# Privacy scan, when this machine has a local denylist (see Tests/README.md).
# The list itself is never committed.
if [ -n "$AHK_MCP_PRIVACY_DENYLIST" ] || [ -n "$AHK_MCP_PRIVACY_DENYLIST_FILE" ]; then
  node scripts/check-privacy.mjs
fi
